---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Partners · ITNRI" description="Partners of the International Translational Neuroscience Research Institute.">
  <h1 class="text-3xl font-bold">Partners</h1>
  <p class="mt-4 text-neutral-600 dark:text-neutral-400">
    ITNRI works with its host institution and academic partners. Details below are limited
    to what has been confirmed so far; additional partners will be added here.
  </p>

  <article class="mt-8 flex flex-col gap-5 rounded-2xl border border-neutral-200 p-6 dark:border-neutral-800 sm:flex-row">
    <img src="/zcmu-logo.png" alt="Zhejiang Chinese Medical University logo" class="h-24 w-24 shrink-0 rounded-full object-cover" />
    <div>
      <h2 class="text-xl font-bold">Zhejiang Chinese Medical University (ZCMU)</h2>
      <p class="mt-1 text-sm font-semibold text-neutral-500">Host institution · Hangzhou, China · Founded 1959</p>
      <p class="mt-3 leading-relaxed text-neutral-700 dark:text-neutral-300">
        Zhejiang Chinese Medical University is the host institution of ITNRI. The institute
        is based at ZCMU in Hangzhou, China, and its director holds a Distinguished
        Professorship at the university.
      </p>
    </div>
  </article>

  <article class="mt-6 rounded-2xl border border-dashed border-neutral-300 p-6 dark:border-neutral-700">
    <h2 class="text-lg font-bold">Additional partners</h2>
    <p class="mt-2 text-neutral-500">Partner introductions to be added.</p>
    <!-- TODO: Add partner names, logos and introductions when confirmed. Do not add unconfirmed partners. -->
  </article>
</Layout>

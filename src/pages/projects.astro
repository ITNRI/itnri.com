---
import Layout from '../layouts/Layout.astro';

// TODO: 替换下面的示例项目
const projects = [
  {
    name: '示例项目 1',
    description: '一句话描述这个项目是干嘛的。',
    link: 'https://github.com/ITNRI',
    linkText: '去 GitHub 看看',
  },
  {
    name: '示例项目 2',
    description: '一句话描述这个项目是干嘛的。',
    link: 'https://github.com/ITNRI',
    linkText: '去 GitHub 看看',
  },
];
---

<Layout title="项目 · ITNRI" description="ITNRI 的项目列表。">
  <h1 class="text-3xl font-bold">项目 / 作品</h1>
  <p class="mt-4 text-neutral-600 dark:text-neutral-400">下面是示例项目，替换成你自己的项目、名字、描述和链接即可。</p>

  <div class="mt-8 space-y-4">
    {
      projects.map((project) => (
        <article class="rounded-2xl border border-neutral-200 p-5 dark:border-neutral-800">
          <h2 class="text-lg font-bold">{project.name}</h2>
          <p class="mt-2 text-neutral-700 dark:text-neutral-300">{project.description}</p>
          <a href={project.link} class="mt-3 inline-block text-sm">{project.linkText} →</a>
        </article>
      ))
    }
  </div>
</Layout>

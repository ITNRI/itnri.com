---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'International Translational Neuroscience Research Institute (ITNRI), Zhejiang Chinese Medical University' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/itnri-logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="border-b border-neutral-200 dark:border-neutral-800">
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-5 py-4">
        <a href="/" class="flex items-center gap-3 no-underline">
          <img src="/itnri-logo.png" alt="ITNRI logo" class="h-11 w-11 rounded-full object-cover" />
          <span class="leading-tight">
            <span class="block text-lg font-bold">ITNRI</span>
            <span class="block text-xs text-neutral-500">Zhejiang Chinese Medical University</span>
          </span>
        </a>
        <nav class="flex flex-wrap gap-5 text-sm">
          <a href="/" class="no-underline hover:underline">Home</a>
          <a href="/institute" class="no-underline hover:underline">Institute</a>
          <a href="/people" class="no-underline hover:underline">People</a>
          <a href="/research" class="no-underline hover:underline">Research</a>
          <a href="/partners" class="no-underline hover:underline">Partners</a>
          <a href="/contact" class="no-underline hover:underline">Contact</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-5 py-10">
      <slot />
    </main>

    <footer class="border-t border-neutral-200 dark:border-neutral-800">
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-5 py-6 text-sm text-neutral-500">
        <p>© 2026 International Translational Neuroscience Research Institute (ITNRI)</p>
        <p>Zhejiang Chinese Medical University, Hangzhou, China</p>
      </div>
    </footer>
  </body>
</html>

<style>
  @import "../styles/global.css";
</style>

---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'International Translational Neuroscience Research Institute (ITNRI)' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/itnri-logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <main class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center px-5 py-10 text-center">
      <slot />
    </main>
    <footer class="border-t border-neutral-200 dark:border-neutral-800">
      <div class="mx-auto max-w-3xl px-5 py-6 text-center text-sm text-neutral-500">
        <p>© 2026 International Translational Neuroscience Research Institute (ITNRI)</p>
        <p>Zhejiang Chinese Medical University, Hangzhou, China</p>
      </div>
    </footer>
  </body>
</html>

<style>
  @import "../styles/global.css";
</style>
